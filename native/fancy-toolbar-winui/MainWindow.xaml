<Window
    x:Class="FancyToolbar.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="8,0" ColumnSpacing="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="Workspaces" Grid.Column="0" Orientation="Horizontal" Spacing="6"
                    VerticalAlignment="Center" HorizontalAlignment="Left" />

        <TextBlock x:Name="FocusedTitle" Grid.Column="1" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="600"
                   Style="{StaticResource BodyTextBlockStyle}" />

        <TextBlock x:Name="Clock" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                   Style="{StaticResource BodyTextBlockStyle}" />
    </Grid>
</Window>
